---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/jetbrains-mono';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifFont from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  /** Case studies are articles; everything else is the website itself. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description, path, ogImage = '/og/index.png', ogType = 'website', noindex = false } = Astro.props;
const fullTitle = path === '/' ? `${SITE.name} · ${SITE.role}` : `${title} · ${SITE.name}`;
const canonical = new URL(path, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const imageAlt = `${title === SITE.name ? SITE.name : title}: ${description}`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  url: SITE.url,
  sameAs: [SITE.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply a saved theme choice before the first paint, so there's no flash.
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {
      SITE.goatcounter && (
        <script
          is:inline
          data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
          async
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="container wide site-header">
      <nav aria-label="Main">
        <a class="name" href="/">{SITE.name}</a>
        <span class="links">
          <a href="/#work">Work</a>
          <a href="/about/">About</a>
          <a href="/resume/">Resume</a>
          <ThemeToggle />
        </span>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="container wide site-footer">
      <div class="footer-inner">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href="/resume/">Resume</a>
        <span class="muted">© 2026 {SITE.name}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 16px;
    padding: 24px 0 8px;
    font-size: 15px;
  }

  .site-header a {
    color: var(--text);
    text-decoration: none;
  }

  .site-header a:hover {
    color: var(--accent);
  }

  .name {
    font-weight: 500;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  main {
    padding: 32px 0 64px;
  }

  /* The rule sits on the inner element so it ends exactly at the content edges. */
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 24px 0 48px;
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  @media print {
    .site-header,
    .site-footer,
    .skip-link {
      display: none;
    }

    main {
      padding: 0;
    }
  }
</style>
