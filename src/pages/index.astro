---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Cite from '../components/Cite.astro';
import ProjectRow from '../components/ProjectRow.astro';
import type { WorkSlug } from '../diagrams';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADSHOT } from '../lib/headshot';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';
import { splitTitle } from '../lib/title';
import { MOMENTS } from '../visuals';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={SITE.name}
  description="Applied AI engineer building production LLM systems: RAG with source-cited answers, agents that verify their own code, real-time LLM pipelines and GPU computer vision."
  path="/"
  ogImage="/og/index.png"
>
  <div class="container wide">
    <section class:list={['hero', { 'with-photo': HEADSHOT }]}>
      <div class="hero-text">
        <p class="kicker">{SITE.name}, {SITE.role}</p>
        <h1>I build production LLM systems: RAG, AI agents and evaluation.</h1>
        <p class="lede">
          I design and ship production AI: retrieval, agents, real-time LLM pipelines and computer vision. At Masterly
          Solutions I've built six AI systems<Cite
            n={1}
            id="hero-systems"
            source="Selected work"
            basis="Six of the case studies on this page are Masterly Solutions work: three client projects and three in-house products, two of them live. The seventh is a personal project."
            href="#work"
            linkText="Go to the work"
          />, the largest used by 600+ staff<Cite
            n={2}
            id="hero-users"
            source="DocuPilot – Enterprise RAG Platform"
            basis="DocuPilot alone is used by 600+ staff in production."
            href="/work/docupilot/#results"
            linkText="Go to DocuPilot's results"
          />.
        </p>
        <p class="ctas">
          <a class="primary" href="#work">View work</a>
          <a href="/resume/">Resume</a>
          <a href={`mailto:${SITE.email}`}>Email me</a>
        </p>
        <p class="remote muted">
          I work remotely from India on IST (UTC+5:30), with 4+ hours of overlap with US East and Europe. Open to
          full-time, contract or employer of record roles.
        </p>
        <p class="cite-note muted">Claims on this site link to their evidence. Tap a small number to see it.</p>
        {
          INTRO_VIDEO.youtubeId && (
            <p class="intro-video">
              <a href={`https://www.youtube.com/watch?v=${INTRO_VIDEO.youtubeId}`} target="_blank" rel="noopener">
                Watch the intro video
              </a>
            </p>
          )
        }
      </div>
      {HEADSHOT && <Image class="photo" src={HEADSHOT} alt="Harsh Nanavati" width={360} height={360} loading="eager" />}
    </section>

    <section id="work">
      <h2>Selected work</h2>
      <ul class="rows">
        {
          work.map((entry) => {
            const Moment = MOMENTS[entry.id as WorkSlug];
            const { name, descriptor } = splitTitle(entry.data.title);
            return (
              <ProjectRow
                href={`/work/${entry.id}/`}
                title={name}
                descriptor={descriptor}
                outcome={entry.data.summary}
                tags={entry.data.tags}
              >
                {Moment && <Moment slot="preview" />}
              </ProjectRow>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2>How I build</h2>
      <div class="principles">
        <p>
          <strong>Answers you can check.</strong> If an AI system can't show where an answer came from, people can't
          trust it. My systems cite their sources, down to the page.<Cite
            n={3}
            id="principle-cite"
            source="DocuPilot's two-stage citation gate"
            basis="Answers cite only passages that clear a minimum score and sit close to the best match, with the exact page region highlighted."
            href="/work/docupilot/#key-decisions"
            linkText="Go to the decision"
          />
        </p>
        <p>
          <strong>Verify before shipping.</strong> Generated code, retrieved context and model output all pass automated
          checks before they reach a user.<Cite
            n={4}
            id="principle-verify"
            source="CrickPal Intelligence Layer's verification harness"
            basis="Generated feature code must pass golden-example, mirror-symmetry, replay-leakage and determinism checks, then human approval."
            href="/work/crickpal-intelligence-layer/#key-decisions"
            linkText="Go to the decision"
          />
        </p>
        <p>
          <strong>Built to keep running.</strong> Retries, job queues, circuit breakers and logging aren't extras.
          Production AI fails in boring ways, and I design for that from day one.<Cite
            n={5}
            id="principle-running"
            source="AI Face Matching's job queue"
            basis="Retry budgets, expiring leases and parked jobs let it run unattended and recover from bad inputs on its own."
            href="/work/ai-face-matching/#key-decisions"
            linkText="Go to the decision"
          />
        </p>
      </div>
    </section>

    <p class="closing">
      Looking for an Applied AI or GenAI engineering role, remote, full-time or contract.{' '}
      <a href={`mailto:${SITE.email}`}>Email me</a> or{' '}
      <a href={SITE.linkedin} target="_blank" rel="noopener">connect on LinkedIn</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding: 24px 0 8px;
  }

  .kicker {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  .hero h1 {
    max-width: 900px;
    margin: 0 0 20px;
    font-size: clamp(2.1rem, 6vw, 3.2rem);
    text-wrap: balance;
  }

  .lede {
    max-width: var(--text-width);
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
  }

  .remote {
    max-width: var(--text-width);
    margin: 1.25rem 0 0;
    font-size: 15px;
  }

  .photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
  }

  .cite-note {
    margin: 1rem 0 0;
    font-size: 14px;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 1.75rem;
  }

  .ctas a {
    font-size: 16px;
    font-weight: 500;
  }

  /* One clear action; the rest are plain links. */
  .ctas a.primary {
    padding: 10px 20px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  .ctas a.primary:hover {
    background: var(--text);
  }

  .rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 40px;
  }

  @media (min-width: 760px) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }

    /* An odd last card takes the full row, its preview beside the text instead of above it. */
    .rows > :global(li:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }

    .rows > :global(li:last-child:nth-child(odd) > a) {
      flex-direction: row;
    }

    .rows > :global(li:last-child:nth-child(odd) .preview) {
      flex: 0 0 calc(50% - 14px);
      border-bottom: 0;
      border-right: 1px solid var(--border);
    }

    .rows > :global(li:last-child:nth-child(odd) .text) {
      align-content: center;
    }

    .hero.with-photo {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .photo {
      width: 220px;
      height: 220px;
    }
  }

  /* Three columns only when each one still has a comfortable line length. */
  @media (min-width: 900px) {
    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principles p {
      margin-top: 0;
    }
  }

  .closing {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
