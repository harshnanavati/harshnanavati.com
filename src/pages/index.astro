---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Cite from '../components/Cite.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADSHOT } from '../lib/headshot';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// Four projects that together show the range: retrieval at scale, enterprise RAG, agents and computer vision.
// The Work page has all of them.
const FEATURED = ['docupilot', 'rag-support-chatbot', 'crickpal-intelligence-layer', 'ai-face-matching'];
const featured = work.filter((entry) => FEATURED.includes(entry.id));

// How I take a project end to end. Each stage carries proof from a project on this site, linked to where
// that project's case study backs it.
const stages = [
  {
    title: 'Understand the problem',
    text: "Start with the people who’ll use it. Pin down requirements and constraints, and let those pick the design.",
    proof: 'RAG removed',
    note: 'Concierge content was ~50 FAQs, so one cached prompt replaced a full RAG pipeline.',
    href: '/work/concierge-chatbot/#key-decisions',
  },
  {
    title: 'Prove it works',
    text: 'Build a small working version and a baseline to beat before anyone commits to the full build.',
    proof: 'Baseline first',
    note: 'CrickPal: an Elo baseline at log-loss 0.643 over 4.1k T20Is sets the bar for every feature.',
    href: '/work/crickpal-intelligence-layer/#results',
  },
  {
    title: 'Build the system',
    text: 'Guardrails and automated checks go in from the start, not after launch.',
    proof: 'Answers cited',
    note: 'DocuPilot links its answers to the exact page they came from.',
    href: '/work/docupilot/#key-decisions',
  },
  {
    title: 'Ship to production',
    text: 'Retries, job queues and logging, so it runs without anyone watching it.',
    proof: 'Runs unattended',
    note: 'Face matching cut manual photo tagging by an estimated ~70%.',
    href: '/work/ai-face-matching/#results',
  },
  {
    title: 'Optimize in production',
    text: 'Measure real use, then make it faster, cheaper and better.',
    proof: '30,000+ questions',
    note: 'The support chatbot has handled 30,000+ questions for 8,800+ people, with staff corrections written back into its knowledge base.',
    href: '/work/rag-support-chatbot/#results',
  },
];
---

<BaseLayout
  title={SITE.name}
  description="Harsh Nanavati is an Applied AI Engineer in Ahmedabad, India, building production LLM systems: RAG, AI agents and evaluation. Open to remote roles."
  path="/"
  ogImage="/og/home.jpg"
>
  <div class="container wide">
    <section class:list={['hero', { 'with-photo': HEADSHOT }]}>
      <div class="hero-head">
        <p class="kicker">{SITE.name}, {SITE.role}</p>
        <h1>I build production LLM systems: RAG, AI agents and evaluation.</h1>
      </div>
      <div class="hero-text">
        <p class="lede">
          I’m Harsh Nanavati, an Applied AI Engineer at Masterly Solutions in Ahmedabad, India. There I’ve built seven
          AI systems<Cite
            n={1}
            id="hero-systems"
            source="Case studies"
            basis="Seven of the eight case studies on the Work page are Masterly Solutions work: four client projects, all live, and three in-house products, two of them live. The eighth is a personal project."
            href="/work/"
            linkText="Go to the work"
          />, the largest used by 8,800+ people<Cite
            n={2}
            id="hero-users"
            source="RAG Support Chatbot – Customer Support Assistant"
            basis="The support chatbot has handled 30,000+ questions for 8,800+ people in production since May 2025."
            href="/work/rag-support-chatbot/#results"
            linkText="Go to the support chatbot’s results"
          />.
        </p>
        <p class="ctas">
          <a class="primary" href="#work">View work</a>
          <a href="/resume/">Resume</a>
          <a href={`mailto:${SITE.email}`}>Email me</a>
        </p>
        <p class="remote muted">
          Open to remote roles. Based in India (IST), and happy to work your team’s hours, in the US or Europe.
        </p>
        {
          INTRO_VIDEO.youtubeId && (
            <p class="intro-video">
              <a href={`https://www.youtube.com/watch?v=${INTRO_VIDEO.youtubeId}`} target="_blank" rel="noopener">
                Watch the intro video
              </a>
            </p>
          )
        }
      </div>
      {HEADSHOT && <Image class="photo" src={HEADSHOT} alt="Harsh Nanavati" width={640} height={640} loading="eager" />}
    </section>

    <section class="build" aria-labelledby="how-i-build">
      <h2 id="how-i-build">How I build</h2>
      <p class="build-lede">
        I take AI projects from the first client conversation to a system running in production. On every project
        here I owned the AI and the backend end to end, and on three of them the front end too.
      </p>
      <ol class="stages">
        {
          stages.map((stage, i) => (
            <li>
              <span class="step" aria-hidden="true">
                {i + 1}
              </span>
              <div class="stage-body">
                <h3>{stage.title}</h3>
                <p class="stage-text">{stage.text}</p>
                <a class="proof" href={stage.href}>
                  <span class="proof-value">{stage.proof}</span>
                  <span class="proof-note">{stage.note}</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="work">
      <h2>Featured work</h2>
      <WorkGrid entries={featured} previews={false} />
      <p class="all-work">
        <a href="/work/">View all {work.length} case studies</a>
      </p>
    </section>

    <section class="contact-card" aria-labelledby="contact">
      <h2 id="contact">Have an AI project or a role in mind?</h2>
      <p>
        I’m looking for a remote Applied AI or GenAI engineering role: full-time, contract or through an employer of
        record.
      </p>
      <p class="contact-actions">
        <a class="primary" href={`mailto:${SITE.email}`}>Email me</a>
        <a href={SITE.linkedin} target="_blank" rel="noopener">
          Connect on LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        <a href="/resume/">See my resume</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 20px 48px;
    padding: 24px 0 8px;
  }

  .kicker {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  .hero h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.1rem, 6vw, 3.2rem);
    text-wrap: balance;
  }

  .lede {
    max-width: var(--text-width);
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
  }

  .remote {
    max-width: var(--text-width);
    margin: 1.25rem 0 0;
    font-size: 15px;
  }

  /* On phones the photo leads the hero, small, so a visitor sees who this is first. */
  /* A hairline ring keeps the photo's light background from melting into the page. */
  .photo {
    order: -1;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--border);
  }


  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 1.75rem;
  }

  .ctas a {
    font-size: 16px;
    font-weight: 500;
  }

  /* One clear action; the rest are plain links. */
  .ctas a.primary {
    padding: 10px 20px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  .ctas a.primary:hover {
    background: var(--text);
  }


  /* How I build: a real sequence, so numbered steps joined by a line.
     Phones read it top to bottom down the line; wide screens read it left to right along it. */
  .build-lede {
    max-width: var(--text-width);
    margin: 0 0 28px;
    font-size: 18px;
    line-height: 1.55;
  }

  .stages {
    --step: 32px;
    position: relative;
    display: grid;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stages::before {
    content: '';
    position: absolute;
    top: calc(var(--step) / 2);
    bottom: calc(var(--step) / 2);
    left: calc(var(--step) / 2 - 1px);
    border-left: 2px solid var(--accent);
    opacity: 0.35;
  }

  .stages li {
    position: relative;
    display: grid;
    grid-template-columns: var(--step) minmax(0, 1fr);
    gap: 16px;
  }

  .step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--step);
    height: var(--step);
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .stage-body {
    max-width: var(--text-width);
  }

  .stage-body h3 {
    text-wrap: balance;
    margin: 4px 0 6px;
    font-family: var(--font-sans);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
  }

  .stage-text {
    margin: 0 0 12px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .proof {
    display: grid;
    align-content: start;
    gap: 2px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .proof-value {
    text-wrap: balance;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--accent);
  }

  .proof-note {
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  .proof:hover .proof-value {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 760px) {
    /* The headline runs the full width; the photo sits beside the intro and buttons below it. */
    .hero.with-photo {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .hero-head {
      grid-column: 1 / -1;
    }

    .photo {
      order: 0;
      width: 220px;
      height: 220px;
    }
  }

  /* Wide screens have room for a photo that holds its own beside the intro. */
  @media (min-width: 1100px) {
    .photo {
      width: 320px;
      height: 320px;
    }
  }

  /* Five across only when each column still has a comfortable line length; below that, the timeline. */
  @media (min-width: 1200px) {
    /* Number, title, text and proof each share a row across all five columns, so the proofs line up. */
    .stages {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      grid-template-rows: auto auto 1fr auto;
      gap: 0 24px;
    }

    .stages::before {
      display: none;
    }

    .stages li {
      grid-row: span 4;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      gap: 0;
    }

    .stage-body {
      display: contents;
    }

    .step {
      margin-bottom: 14px;
    }

    /* The line joins one step to the next and stops at the last. */
    .stages li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(var(--step) / 2 - 1px);
      left: var(--step);
      width: calc(100% + 24px - var(--step));
      border-top: 2px solid var(--accent);
      opacity: 0.35;
    }
  }

  .all-work {
    margin: 28px 0 0;
    text-align: center;
  }

  .all-work a {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
  }

  .all-work a:hover {
    border-color: var(--accent);
  }

  /* The page ends on one clear next step. */
  .contact-card {
    margin-top: 4rem;
    padding: 32px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .contact-card h2 {
    margin: 0 0 10px;
  }

  .contact-card p {
    max-width: var(--text-width);
    margin: 0;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 20px !important;
  }

  .contact-actions a {
    font-weight: 500;
  }

  .contact-actions a.primary {
    padding: 10px 20px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  .contact-actions a.primary:hover {
    background: var(--text);
  }

  @media (max-width: 520px) {
    .contact-card {
      padding: 24px 20px;
    }
  }
</style>
