---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ProjectRow from '../components/ProjectRow.astro';
import type { WorkSlug } from '../diagrams';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADSHOT } from '../lib/headshot';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';
import { MOMENTS } from '../visuals';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={SITE.name}
  description="Applied AI engineer building production LLM systems: RAG with source-cited answers, agents that verify their own code, real-time LLM pipelines and GPU computer vision."
  path="/"
  ogImage="/og/index.png"
  width="wide"
>
  <div class="container wide">
    <section class:list={['hero', { 'with-photo': HEADSHOT }]}>
      <div class="hero-text">
        <h1>I build production AI systems that people actually use.</h1>
        <p class="sub muted">
          I'm an applied AI engineer in India, working remotely with teams in Europe and the US. I design and ship LLM
          systems: retrieval, agents and real-time pipelines.
        </p>
        <p class="current">
          Currently an AI engineer at Masterly Solutions, with 2+ years shipping LLM systems used by 600+ people.
        </p>
        <p class="ctas">
          <a class="primary" href="#work">View work</a>
          <a href="/resume">Resume</a>
          <a href={`mailto:${SITE.email}`}>Email me</a>
        </p>
        {
          INTRO_VIDEO.youtubeId && (
            <p class="intro-video">
              <a href={`https://www.youtube.com/watch?v=${INTRO_VIDEO.youtubeId}`} target="_blank" rel="noopener">
                Watch the intro video
              </a>
            </p>
          )
        }
      </div>
      {HEADSHOT && <Image class="photo" src={HEADSHOT} alt="Harsh Nanavati" width={360} height={360} loading="eager" />}
    </section>

    <section id="work">
      <h2>Selected work</h2>
      <ul class="rows">
        {
          work.map((entry) => {
            const Moment = MOMENTS[entry.id as WorkSlug];
            return (
              <ProjectRow
                href={`/work/${entry.id}/`}
                title={entry.data.title}
                outcome={entry.data.summary}
                tags={entry.data.tags}
              >
                {Moment && <Moment slot="preview" />}
              </ProjectRow>
            );
          })
        }
      </ul>
    </section>

    <section>
      <h2>How I build</h2>
      <div class="principles">
        <p>
          <strong>Answers you can check.</strong> If an AI system can't show where an answer came from, people can't
          trust it. My systems cite their sources, down to the page.
        </p>
        <p>
          <strong>Verify before shipping.</strong> Generated code, retrieved context and model output all pass automated
          checks before they reach a user.
        </p>
        <p>
          <strong>Built to keep running.</strong> Retries, job queues, circuit breakers and logging aren't extras.
          Production AI fails in boring ways, and I design for that from day one.
        </p>
      </div>
    </section>

    <p class="closing">
      Looking for an Applied AI or GenAI engineering role, remote, full-time or contract.{' '}
      <a href={`mailto:${SITE.email}`}>Email me</a> or{' '}
      <a href={SITE.linkedin} target="_blank" rel="noopener">connect on LinkedIn</a>.
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: 32px;
    padding: 24px 0 8px;
  }

  .hero h1 {
    max-width: 780px;
    font-size: clamp(2.1rem, 6vw, 3.2rem);
  }

  .sub,
  .current {
    max-width: var(--text-width);
    font-size: 1.05rem;
  }

  .sub {
    margin-bottom: 0.5rem;
  }

  .current {
    margin-top: 0;
  }

  .photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: cover;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 1.5rem;
  }

  .ctas a {
    padding: 8px 16px;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    font-size: 15px;
  }

  .ctas a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ctas a.primary {
    border-color: var(--accent);
    color: var(--accent);
    font-weight: 500;
  }

  .rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 40px;
  }

  @media (min-width: 760px) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px;
    }

    .principles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principles p {
      margin-top: 0;
    }

    .hero.with-photo {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }

    .photo {
      width: 220px;
      height: 220px;
    }
  }

  .closing {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
