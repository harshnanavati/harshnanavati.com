---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RESUME, RESUME_PDF } from '../lib/resume';
import { SITE } from '../lib/site';

const skills = RESUME.skills.map((s) => ({ group: s.group, tags: s.items.split(', ') }));
---

<BaseLayout
  title="Resume"
  description="Resume of Harsh Nanavati, Applied AI Engineer: LLMs, RAG, agentic systems and evaluation."
  path="/resume/"
  ogImage="/og/resume.png"
>
  <article class="container wide resume">
    <header class="top">
      <div>
        <h1>Harsh Nanavati</h1>
        <p class="headline">{RESUME.headline}</p>
        <p class="contact">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <span class="muted">Ahmedabad, India (IST), open to remote roles</span>
        </p>
      </div>
      <a class="download" href={RESUME_PDF} download>Download PDF</a>
    </header>

    <div class="columns">
      <div class="resume-main">
        <section>
          <h2>Summary</h2>
          <p class="summary">{RESUME.summary}</p>
        </section>

        <section>
          <h2>Experience</h2>
          {
            RESUME.experience.map((job) => (
              <div class="job">
                <div class="job-head">
                  <h3>{job.role}</h3>
                  <p class="when">{job.when}</p>
                </div>
                <p class="company">
                  {job.company}, {job.where}
                </p>
                {job.note && <p class="note">{job.note}</p>}
                <ul class="points">
                  {job.points.map((p) => (
                    <li>
                      {p.lead && <strong class="lead">{p.lead}</strong>}
                      <span>{p.lead ? p.text.charAt(0).toUpperCase() + p.text.slice(1) : p.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>
      </div>

      <aside class="resume-aside" aria-label="Skills, education and research">
        <section>
          <h2>Skills</h2>
          {
            skills.map((s) => (
              <div class="skill-group">
                <h3>{s.group}</h3>
                <ul class="skill-tags">
                  {s.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </section>

        <section>
          <h2>Education</h2>
          {
            RESUME.education.map((e) => (
              <div class="fact">
                <h3>{e.degree}</h3>
                <p>{e.school}</p>
                <p class="muted">
                  {e.when}, {e.detail}
                </p>
              </div>
            ))
          }
        </section>

        <section>
          <h2>Research</h2>
          <div class="fact">
            <h3>{RESUME.research.title}</h3>
            <p class="muted">{RESUME.research.text}</p>
          </div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px 32px;
    padding: 16px 0 28px;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(2.1rem, 4.2vw, 3rem);
    margin-bottom: 6px;
  }

  .headline {
    margin: 0 0 10px;
    font-size: 1.15rem;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    font-size: 15px;
  }

  .download {
    padding: 10px 18px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .download:hover {
    opacity: 0.9;
  }

  .columns {
    display: grid;
    gap: 48px;
    margin-top: 32px;
  }

  h2 {
    margin: 0 0 16px;
    font-size: 1.35rem;
  }

  section + section {
    margin-top: 40px;
  }

  .summary {
    max-width: 680px;
    margin: 0;
    font-size: 1.05rem;
  }

  /* Experience */
  .job + .job {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 16px;
  }

  h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .when {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .company {
    margin: 2px 0 0;
    color: var(--muted);
  }

  .note {
    margin: 6px 0 0;
    font-size: 15px;
  }

  .points {
    display: grid;
    gap: 14px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    display: grid;
    gap: 2px;
    padding-left: 16px;
    border-left: 2px solid var(--border);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .lead {
    font-weight: 600;
    color: var(--accent);
  }

  /* Side column */
  .skill-group + .skill-group {
    margin-top: 16px;
  }

  .skill-group h3,
  .fact h3 {
    font-size: 14.5px;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  .skill-tags li {
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13px;
    line-height: 1.5;
  }

  .fact + .fact {
    margin-top: 14px;
  }

  .fact p {
    margin: 2px 0 0;
    font-size: 14.5px;
    line-height: 1.5;
  }

  @media (min-width: 1024px) {
    .columns {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 64px;
      align-items: start;
    }

    .resume-aside {
      padding: 24px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--surface);
    }

    .resume-aside .skill-tags li {
      background: var(--bg);
    }
  }

  /* On paper: no download button, the facts beside the experience, compact spacing. */
  @media print {
    @page {
      size: A4;
      margin: 14mm 14mm;
    }

    .download {
      display: none;
    }

    .columns {
      grid-template-columns: minmax(0, 1fr) 190px;
      gap: 28px;
      align-items: start;
    }

    .resume-aside {
      padding: 0;
      border: 0;
      background: none;
    }

    li {
      break-inside: avoid;
    }
  }
</style>
