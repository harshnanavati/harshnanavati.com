---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RESUME, RESUME_PDF } from '../lib/resume';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Resume"
  description="Resume of Harsh Nanavati, Applied AI Engineer: LLMs, RAG, agentic systems and evaluation."
  path="/resume/"
  ogImage="/og/resume.png"
>
  <article class="container resume">
    <header class="top">
      <div>
        <h1>Harsh Nanavati</h1>
        <p class="headline">{RESUME.headline}</p>
        <p class="contact">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <span class="muted">Ahmedabad, India (IST), remote</span>
        </p>
      </div>
      <a class="download" href={RESUME_PDF} download>Download PDF</a>
    </header>

    <section>
      <h2>Summary</h2>
      <p>{RESUME.summary}</p>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {
          RESUME.skills.map((s) => (
            <div>
              <dt>{s.group}</dt>
              <dd>{s.items}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section>
      <h2>Experience</h2>
      {
        RESUME.experience.map((job) => (
          <div class="job">
            <div class="job-head">
              <p class="job-title">
                <strong>{job.role}</strong>, {job.company}
              </p>
              <p class="when">{job.when}</p>
            </div>
            <p class="where">{job.note ? `${job.where}. ${job.note}` : job.where}</p>
            <ul>
              {job.points.map((p) => (
                <li>
                  {p.lead && <strong>{p.lead}:</strong>} {p.text}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Research</h2>
      <p><strong>{RESUME.research.title}</strong>. {RESUME.research.text}</p>
    </section>

    <section>
      <h2>Education</h2>
      <ul class="education">
        {
          RESUME.education.map((e) => (
            <li>
              <span>
                <strong>{e.degree}</strong>, {e.school}. {e.detail}
              </span>
              <span class="when">{e.when}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin-bottom: 4px;
  }

  .headline {
    margin: 0 0 8px;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    margin: 0;
    font-size: 15px;
  }

  .download {
    padding: 8px 16px;
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  section h2 {
    margin-top: 2.25rem;
  }

  .skills {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .skills div {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 16px;
  }

  dt {
    font-weight: 500;
  }

  dd {
    margin: 0;
  }

  .job + .job {
    margin-top: 1.75rem;
  }

  .job-head,
  .education li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2px 16px;
  }

  .job-title,
  .where {
    margin: 0;
  }

  .when {
    margin: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .where {
    color: var(--muted);
    font-size: 15.5px;
  }

  .job ul {
    margin: 10px 0 0;
    padding-left: 1.2rem;
  }

  .job li + li {
    margin-top: 6px;
  }

  .education {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .education li + li {
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .skills div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
