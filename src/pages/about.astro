---
import { Image } from 'astro:assets';
import VideoSlot from '../components/VideoSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADSHOT } from '../lib/headshot';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';
import talkApr2025 from '../assets/talks/apr-2025-ai-pipeline.jpg';
import talkAug2025 from '../assets/talks/aug-2025-ai-session.jpg';
import talkJan2025 from '../assets/talks/jan-2025-bvm.jpg';
import talkMay2026 from '../assets/talks/may-2026-rag-webinar.jpg';
import talkSep2026 from '../assets/talks/sep-2026-launch.jpg';

// Newest first. Numbers come from Harsh's own accounts and LinkedIn posts of each event.
const talks = [
  {
    when: 'Sep 2026',
    title: 'Hosted a product launch',
    detail: 'Hosted the launch event for a new Masterly Solutions product.',
    photo: talkSep2026,
    alt: 'Harsh hosting the product launch with a microphone, the audience behind him',
  },
  {
    when: 'May 2026',
    title: 'RAG Decision Map, a free webinar',
    detail:
      'A 2-hour online session for 35+ engineering students and IT professionals on what to choose at each stage of a RAG system, from chunking and embeddings to retrieval and reranking, and why.',
    photo: talkMay2026,
    alt: 'Announcement poster for the RAG Decision Map webinar on 21 May, hosted by Harsh Nanavati',
  },
  {
    when: 'Aug 2025',
    title: 'A 2-hour AI session for 80+ people',
    detail:
      '40+ students from Birla Vishwakarma Mahavidyalaya and 40+ IT professionals at Masterly Solutions, from the origins of AI to LangChain, LangGraph and RAG.',
    photo: talkAug2025,
    alt: 'Harsh presenting a slide on generative adversarial networks',
  },
  {
    when: 'Apr 2025',
    title: 'From Chaos to Clarity: The AI Pipeline',
    detail: 'A talk on how an AI pipeline comes together, for 60+ IT professionals from inside and outside the company.',
    photo: talkApr2025,
    alt: 'Harsh on stage in front of the From Chaos to Clarity title slide',
  },
  {
    when: 'Jan 2025',
    title: 'AI and data science at BVM',
    detail: 'Visited Birla Vishwakarma Mahavidyalaya, Vallabh Vidyanagar, to talk about AI and data science with 120+ students.',
    photo: talkJan2025,
    alt: 'Harsh standing beside a slide at Birla Vishwakarma Mahavidyalaya',
  },
];

const timeline = [
  {
    when: '2024 – now',
    role: 'SDE – Artificial Intelligence (Applied AI Engineer)',
    where: 'Masterly Solutions, Ahmedabad',
    detail: 'In-house products like CrickPal and QuantumCopilot, and client systems for organizations in the US and India.',
  },
  {
    when: '2023 – 2024',
    role: 'Data Science and Big Data Intern',
    where: 'Deloitte Haskins & Sells LLP, remote',
    detail: 'Spark, Scala and SQL on large financial datasets for audit teams.',
  },
  {
    when: '2022 – 2024',
    role: 'M.Tech, Data Science',
    where: 'Nirma University, Ahmedabad',
    detail: 'Research on federated learning, blockchain and explainable AI for privacy-preserving Parkinson’s detection.',
  },
  {
    when: '2017 – 2021',
    role: 'B.E., Computer Engineering',
    where: 'LDRP-ITR, Gandhinagar',
    detail: '',
  },
];
---

<BaseLayout
  title="About"
  description="Harsh Nanavati is an applied AI engineer from Ahmedabad, India, looking for a remote Applied AI or GenAI engineering role."
  path="/about/"
  ogImage="/og/about.png"
>
  <div class="container wide">
    <div class="measure">
      <div class="intro">
        <h1>About</h1>
        {
          HEADSHOT ? (
            <Image class="headshot" src={HEADSHOT} alt="Harsh Nanavati" width={224} height={224} loading="eager" />
          ) : (
            <div class="headshot placeholder" aria-hidden="true">
              HN
            </div>
          )
        }
      </div>

      <p>
        I'm Harsh, an applied AI engineer from Ahmedabad, India. I build AI systems that run in production: assistants that
        answer from company documents, agents that write and test their own code, real-time LLM pipelines and GPU computer
        vision.
      </p>

      <h2 id="experience">Experience and education</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <span class="when">{item.when}</span>
              <div class="entry">
                <p class="role">{item.role}</p>
                <p class="where">{item.where}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>

      <h2>How I work</h2>
      <p>
        I care about the boring parts that make AI trustworthy: citations, verification, retries and logs. I'd rather ship
        something smaller that works every time than a demo that works once.
      </p>

      <h2 id="talks">Talks and sessions</h2>
      <ul class="talks">
        {
          talks.map((talk) => (
            <li>
              <Image class="talk-photo" src={talk.photo} alt={talk.alt} width={320} height={240} />
              <div>
                <p class="when">{talk.when}</p>
                <p class="role">{talk.title}</p>
                <p class="detail">{talk.detail}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <h2>What I'm looking for</h2>
      <p>
        An Applied AI or GenAI engineering role, fully remote, full-time or contract, including through an employer of
        record. I'm on IST (UTC+5:30) and comfortable with 4+ hours of overlap with Europe or the US East Coast.
      </p>
      <p class="contact">
        <a href={`mailto:${SITE.email}`}>Email me</a>{' · '}
        <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>{' · '}
        <a href="/resume/">Resume</a>
      </p>

      {INTRO_VIDEO.youtubeId && <VideoSlot title={INTRO_VIDEO.title} youtubeId={INTRO_VIDEO.youtubeId} />}
    </div>
  </div>
</BaseLayout>

<style>
  /* Heading on the left edge like every other page; the portrait sits to its right. */
  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 1rem;
  }

  .intro h1 {
    margin: 0;
  }

  .headshot {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-serif);
    font-size: 36px;
  }

  /* A real sequence, newest first: dates on the left, a rule joining the entries. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 20px;
  }

  .when {
    padding-top: 2px;
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .entry {
    position: relative;
    padding: 0 0 24px 20px;
    border-left: 1px solid var(--border);
  }

  .entry::before {
    content: '';
    position: absolute;
    top: 9px;
    left: -5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline li:last-child .entry {
    padding-bottom: 0;
  }

  .entry p {
    margin: 0;
  }

  .role {
    font-weight: 500;
  }

  .where {
    color: var(--muted);
  }

  .detail {
    margin-top: 4px !important;
    font-size: 15.5px;
  }

  /* Same date and title treatment as the timeline, with the photo where the date column was. */
  .talks {
    display: grid;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .talks li {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }

  .talks p {
    margin: 0;
  }

  .talks .when {
    padding: 0;
  }

  .talk-photo {
    width: 160px;
    height: 120px;
    border-radius: 8px;
    object-fit: cover;
  }

  @media (max-width: 520px) {
    .talks li {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 14px;
    }

    .talk-photo {
      width: 112px;
      height: 84px;
    }

    .timeline li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .when {
      padding-left: 20px;
    }
  }
</style>
