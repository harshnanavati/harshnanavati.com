---
import { Image } from 'astro:assets';
import VideoSlot from '../components/VideoSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HEADSHOT } from '../lib/headshot';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';

const timeline = [
  {
    when: '2024 – now',
    role: 'SDE – Artificial Intelligence (Applied AI Engineer)',
    where: 'Masterly Solutions, Ahmedabad',
    detail: 'In-house products like CrickPal and QuantumCopilot, and client systems for a US organization.',
  },
  {
    when: '2023 – 2024',
    role: 'Data Science and Big Data Intern',
    where: 'Deloitte Haskins & Sells LLP, remote',
    detail: 'Spark, Scala and SQL on large financial datasets for audit teams.',
  },
  {
    when: '2022 – 2024',
    role: 'M.Tech, Data Science',
    where: 'Nirma University, Ahmedabad',
    detail: 'Research on federated learning, blockchain and explainable AI for privacy-preserving Parkinson’s detection.',
  },
  {
    when: '2017 – 2021',
    role: 'B.E., Computer Engineering',
    where: 'LDRP-ITR, Gandhinagar',
    detail: '',
  },
];
---

<BaseLayout
  title="About"
  description="Harsh Nanavati is an applied AI engineer from Ahmedabad, India, looking for a remote Applied AI or GenAI engineering role."
  path="/about/"
  ogImage="/og/about.png"
>
  <div class="container wide about">
    <div class="about-intro">
      <h1>About Harsh Nanavati</h1>
      <p class="lede">
        I’m Harsh Nanavati, an Applied AI Engineer at Masterly Solutions in Ahmedabad, India. I build AI systems that run
        in production: assistants that answer from company documents, AI agents whose code must pass automated tests and a
        human review before it goes live, real-time LLM pipelines and GPU computer vision.
      </p>
    </div>

    <aside class="about-card" aria-label="At a glance">
      {
        HEADSHOT ? (
          <Image class="headshot" src={HEADSHOT} alt="Harsh Nanavati" width={480} height={480} loading="eager" />
        ) : (
          <div class="headshot placeholder" aria-hidden="true">
            HN
          </div>
        )
      }
      <p class="card-name">{SITE.name}</p>
      <p class="card-role">{SITE.role}</p>
      <dl class="facts">
        <div>
          <dt>Based in</dt>
          <dd>Ahmedabad, India</dd>
        </div>
        <div>
          <dt>Time zone</dt>
          <dd>IST (UTC+5:30), working your team’s hours, US or Europe</dd>
        </div>
        <div>
          <dt>Open to</dt>
          <dd>Remote roles: full-time, contract or employer of record</dd>
        </div>
      </dl>
      <p class="contact">
        <a class="primary" href={`mailto:${SITE.email}`}>Email me</a>
        <a href={SITE.linkedin} target="_blank" rel="noopener">
          LinkedIn<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
        <a href="/resume/">Resume</a>
      </p>
    </aside>

    <div class="about-main">
      <h2 id="experience">Experience and education</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li>
              <span class="when">{item.when}</span>
              <div class="entry">
                <p class="role">{item.role}</p>
                <p class="where">{item.where}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ol>

      <h2>How I work</h2>
      <p>
        I care about the boring parts that make AI trustworthy: citations, verification, retries and logs. I’d rather ship
        something smaller that works every time than a demo that works once.
      </p>

      <h2>What I’m looking for</h2>
      <p>
        An Applied AI or GenAI engineering role, fully remote, full-time or contract, including through an employer of
        record. I’m based in India (IST, UTC+5:30) and happy to work your team’s hours, whether you’re in the US or Europe.
      </p>

      {INTRO_VIDEO.youtubeId && <VideoSlot title={INTRO_VIDEO.title} youtubeId={INTRO_VIDEO.youtubeId} />}
    </div>
  </div>
</BaseLayout>

<style>
  /* Two columns on wide screens, like the resume: the story on the left, a card with the facts and
     contact links on the right that stays in view. Narrower screens put the card under the intro. */
  .about {
    display: grid;
    gap: 40px;
  }

  .about-intro h1 {
    margin-top: 0;
  }

  .about-intro .lede {
    margin-bottom: 0;
  }

  /* On phones the card is compact: a small photo beside the name and role, the facts below. */
  .about-card {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    grid-template-areas:
      'photo name'
      'photo role'
      'facts facts'
      'contact contact';
    column-gap: 16px;
    align-items: center;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .about-main {
    min-width: 0;
  }

  .about-main > h2:first-child {
    margin-top: 0;
  }

  .lede {
    font-size: 1.1rem;
  }

  .headshot {
    grid-area: photo;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    object-fit: cover;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-serif);
    font-size: 48px;
  }

  .card-name {
    grid-area: name;
    align-self: end;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .card-role {
    grid-area: role;
    align-self: start;
    margin: 2px 0 0;
    font-weight: 500;
    color: var(--accent);
  }

  .facts {
    grid-area: facts;
    display: grid;
    gap: 10px;
    margin: 18px 0;
  }

  .facts dt {
    font-size: 13px;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }

  /* Three matching buttons in one row; Email me is the filled, slightly wider one. */
  .contact {
    grid-area: contact;
    justify-self: stretch;
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 8px;
    margin: 0;
  }

  .contact a {
    padding: 8px 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: transparent;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
  }

  .contact a:hover {
    border-color: var(--accent);
  }

  .contact a.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .contact a.primary:hover {
    border-color: var(--text);
    background: var(--text);
  }

  @media (min-width: 960px) {
    /* The card may scroll on down beside the footer (whose links sit on the left), so at the very end
       of the page it stays put instead of being pushed up under the header. The extra room is the page's
       bottom padding plus the footer, taken back with a negative margin so nothing else moves. */
    .about {
      --card-room: 240px;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 0 64px;
      align-items: start;
      margin-bottom: calc(-1 * var(--card-room));
    }

    .about-intro {
      grid-column: 1;
      margin-bottom: 40px;
    }

    .about-main {
      grid-column: 1;
      padding-bottom: var(--card-room);
    }

    /* The card spans both rows of the story, so it can stay in view the whole way down. */
    .about-card {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    /* Below the story the footer keeps to the story's column, so on a laptop-height screen the card
       sits beside it rather than on top of its rule. */
    :global(body:has(.about-card) .footer-inner) {
      max-width: calc(100% - 340px - 64px);
    }

    /* Wide screens: one column inside the card, a centred profile at the top (photo, name, role), then
       the facts left-aligned under a rule so they scan easily. It locks at exactly the height it starts
       at (the header plus the page's top padding), so it never shifts on the first scroll. Spacing is
       kept tight so the card stays short enough to remain in view on a laptop screen. */
    .about-card {
      position: sticky;
      top: calc(var(--header-height) + var(--main-top));
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'photo' 'name' 'role' 'facts' 'contact';
      justify-items: stretch;
      padding: 22px 24px 24px;
    }

    .headshot {
      justify-self: center;
      width: 200px;
      height: 200px;
      margin-bottom: 12px;
    }

    .card-name,
    .card-role {
      text-align: center;
    }

    .card-role {
      margin-top: 2px;
    }

    .facts {
      gap: 7px;
      margin: 14px 0 16px;
      padding-top: 12px;
      border-top: 1px solid var(--border);
    }

    .facts dd {
      line-height: 1.4;
    }
  }

  /* A real sequence, newest first: dates on the left, a rule joining the entries. */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 20px;
  }

  .when {
    padding-top: 2px;
    font-size: 14px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .entry {
    position: relative;
    padding: 0 0 24px 20px;
    border-left: 1px solid var(--border);
  }

  .entry::before {
    content: '';
    position: absolute;
    top: 9px;
    left: -5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
  }

  .timeline li:last-child .entry {
    padding-bottom: 0;
  }

  .entry p {
    margin: 0;
  }

  .role {
    font-weight: 500;
  }

  .where {
    color: var(--muted);
  }

  .detail {
    margin-top: 4px !important;
    font-size: 15.5px;
  }

  @media (max-width: 520px) {
    .timeline li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }

    .when {
      padding-left: 20px;
    }
  }
</style>
