---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import VideoSlot from '../components/VideoSlot.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { INTRO_VIDEO } from '../lib/intro';
import { SITE } from '../lib/site';

const headshots = import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', {
  eager: true,
});
const headshot = Object.values(headshots)[0]?.default;
---

<BaseLayout
  title="About"
  description="Harsh Nanavati is an applied AI engineer from Ahmedabad, India, looking for a remote Applied AI or GenAI engineering role."
  path="/about/"
  ogImage="/og/about.png"
>
  <div class="container">
    <div class="intro">
      {
        headshot ? (
          <Image class="headshot" src={headshot} alt="Harsh Nanavati" width={112} height={112} />
        ) : (
          <div class="headshot placeholder" aria-hidden="true">
            HN
          </div>
        )
      }
      <h1>About</h1>
    </div>

    <p>
      I'm Harsh, an applied AI engineer from Ahmedabad, India. I build AI systems that run in production: assistants that
      answer from company documents, agents that write and test their own code, real-time LLM pipelines and GPU computer
      vision.
    </p>
    <p>
      I started in data. After a bachelor's in computer engineering, I did a master's in data science at Nirma University,
      where my research combined federated learning, blockchain and explainable AI for privacy-preserving Parkinson's
      detection. Alongside it, I interned at Deloitte, working on large financial datasets with Spark and SQL for audit
      teams.
    </p>
    <p>
      Since October 2024, I've been an AI engineer at Masterly Solutions, shipping in-house products like CrickPal and
      QuantumCopilot, as well as client systems for organizations in the US and India.
    </p>
    <p>
      <strong>How I work.</strong> I care about the boring parts that make AI trustworthy: citations, verification, retries
      and logs. I'd rather ship something smaller that works every time than a demo that works once.
    </p>
    <p>
      <strong>What I'm looking for.</strong> An Applied AI or GenAI engineering role, fully remote, full-time or contract,
      including through an employer of record. I'm on IST (UTC+5:30) and comfortable with 4+ hours of overlap with Europe
      or the US East Coast.
    </p>
    <p class="contact">
      <a href={`mailto:${SITE.email}`}>Email me</a>{' · '}
      <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>{' · '}
      <a href="/resume">Resume</a>
    </p>

    {INTRO_VIDEO.youtubeId && <VideoSlot title={INTRO_VIDEO.title} youtubeId={INTRO_VIDEO.youtubeId} />}
  </div>
</BaseLayout>

<style>
  .intro {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 1rem;
  }

  .intro h1 {
    margin: 0;
  }

  .headshot {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-serif);
    font-size: 32px;
  }
</style>
