---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Cite from '../../components/Cite.astro';
import Diagram from '../../components/Diagram.astro';
import LinksOut from '../../components/LinksOut.astro';
import VideoSlot from '../../components/VideoSlot.astro';
import { DIAGRAMS, type WorkSlug } from '../../diagrams';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { firstCommitDate, lastCommitDate } from '../../lib/git-dates';
import { SITE } from '../../lib/site';
import { splitTitle } from '../../lib/title';
import { MOMENTS } from '../../visuals';

export async function getStaticPaths() {
  const entries = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: entries[(i + 1) % entries.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const { data } = entry;
const slug = entry.id as WorkSlug;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
const Moment = MOMENTS[slug];
const { name, descriptor } = splitTitle(data.title);
// Result cells hold measurable numbers only. Descriptive chips ("Self-hosted LLM") are
// already told in the text; a single number sits in the details card instead of a lone cell.
const numbers = data.chips.filter((chip) => /\d/.test(chip.value));
const showStats = numbers.length >= 2;
const soloResult = numbers.length === 1 ? numbers[0] : undefined;
// Every number carries a citation to the section of this page that backs it.
const sectionTitle = (id?: string) => sections.find((s) => s.slug === id)?.text ?? 'the evidence';
const cite = (chip: (typeof numbers)[number], i: number) => ({
  n: i + 1,
  id: `${slug}-${i + 1}`,
  source: `${chip.value} ${chip.label}`,
  basis: chip.basis ?? '',
  href: `#${chip.evidence}`,
  linkText: `Go to ${sectionTitle(chip.evidence)}`,
});
// Who made it, said once in plain words, so it isn't lost when the page is read as text.
const byline = /personal/i.test(data.kind)
  ? `Personal project by ${SITE.name}`
  : `Built by ${SITE.name} at ${SITE.employerShort}`;
// Structured data for this case study: an article by Harsh, and where it sits on the site.
const path = `/work/${slug}/`;
const canonical = new URL(path, SITE.url).href;
// When the case study was first published and last changed, from its source file's git history.
const sourceFile = `src/content/work/${slug}.mdx`;
const datePublished = firstCommitDate(sourceFile);
const dateModified = lastCommitDate(sourceFile);
const personRef = { '@id': `${SITE.url}/#person` };
const schema = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: data.title,
    description: data.description,
    url: canonical,
    mainEntityOfPage: canonical,
    image: new URL(`/og/${slug}.png`, SITE.url).href,
    author: personRef,
    publisher: personRef,
    keywords: data.tags.join(', '),
    ...(datePublished && { datePublished }),
    ...(dateModified && { dateModified }),
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/work/', SITE.url).href },
      { '@type': 'ListItem', position: 3, name, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  path={path}
  ogImage={`/og/${slug}.png`}
  ogType="article"
  schema={schema}
>
  <div class="case-bar" aria-hidden="true" data-nosnippet>
    <div class="container wide case-bar-inner">
      <span class="case-bar-text">
        <span class="case-bar-name">{name}</span>
        {descriptor && <span class="case-bar-descriptor">{descriptor}</span>}
      </span>
    </div>
  </div>

  <article class="container wide case">
    <header class="hero">
      <div class="hero-text">
        <h1>{name}</h1>
        {descriptor && <p class="descriptor">{descriptor}</p>}
        <p class="byline">{byline}</p>
        <p class="outcome">{data.outcome}</p>
      </div>
      <aside class="meta-card" aria-label="Project details">
        <dl>
          {
            data.role && (
              <div>
                <dt>Role</dt>
                <dd>{data.role}</dd>
              </div>
            )
          }
          <div>
            <dt>Type</dt>
            <dd>{data.kind}</dd>
          </div>
          {
            soloResult && (
              <div>
                <dt>In numbers</dt>
                <dd class="result">
                  <span class="result-value">{soloResult.value}</span> {soloResult.label}
                  <Cite {...cite(soloResult, 0)} />
                </dd>
              </div>
            )
          }
          <div>
            <dt>Stack</dt>
            <dd class="stack">{data.stack.join(', ')}</dd>
          </div>
        </dl>
        {data.links && <LinksOut links={data.links} />}
      </aside>
    </header>

    {
      showStats && (
        <ul class="stats" aria-label="Results at a glance">
          {numbers.map((chip, i) => (
            <li>
              <span class="value-row">
                <span class="value">{chip.value}</span>
                <Cite {...cite(chip, i)} />
              </span>
              <span class="label">{chip.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    {data.privacyNote && <p class="privacy-note">{data.privacyNote}</p>}

    <section class="stage" data-nosnippet aria-label={Moment ? 'What the product does' : 'How it works at a glance'}>
      {Moment ? <Moment /> : <Diagram diagram={DIAGRAMS[slug][0]} />}
    </section>

    {data.youtubeId && <VideoSlot title={data.videoTitle} youtubeId={data.youtubeId} />}

    <div class="body">
      <nav class="toc" aria-label="On this page">
        <ul>
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.slug}`}>{s.text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="prose">
        <Content />
      </div>
    </div>

    <p class="next">
      <a class="next-project" href={`/work/${next.id}/`}>
        <span class="next-label">Next project</span>
        <span class="next-title">{splitTitle(next.data.title).name}</span>
      </a>
    </p>
  </article>
</BaseLayout>

<script>
  // Once the big title scrolls up under the header, a slim bar with the project's name takes its place,
  // so a reader always knows which project they're in. It goes away when the title comes back.
  const bar = document.querySelector('.case-bar');
  const title = document.querySelector('main h1');
  if (bar && title) {
    const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 72;
    new IntersectionObserver(
      ([entry]) => bar.classList.toggle('shown', !entry.isIntersecting && entry.boundingClientRect.top < header),
      { rootMargin: `-${header}px 0px 0px 0px` },
    ).observe(title);
  }

  // Highlight the section being read in the side nav.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('nav.toc a')].map((a) => [a.hash.slice(1), a]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links.values()) a.removeAttribute('aria-current');
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '0px 0px -70% 0px' },
  );
  for (const id of links.keys()) {
    const heading = document.getElementById(id);
    if (heading) observer.observe(heading);
  }
</script>

<style>
  /* Jumps to a section stop below both the header and the project-name bar. */
  :global(html:has(.case-bar)) {
    --case-bar: 48px;
    scroll-padding-top: calc(var(--header-height) + var(--case-bar) + 16px);
  }

  .case-bar {
    position: fixed;
    top: var(--header-height);
    right: 0;
    left: 0;
    z-index: 40;
    background: var(--bg);
    box-shadow: 0 1px 0 var(--border);
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.2s ease,
      visibility 0.2s;
  }

  .case-bar.shown {
    transform: none;
    visibility: visible;
  }

  /* The text is centred in the bar; min-height lets it grow rather than clip if a reader enlarges spacing. */
  .case-bar-inner {
    display: flex;
    align-items: center;
    min-height: var(--case-bar);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
  }

  .case-bar-text {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-width: 0;
  }

  .case-bar-name {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
  }

  .case-bar-descriptor {
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 14px;
    color: var(--muted);
  }

  /* Phones have room for the name only. */
  @media (max-width: 599px) {
    .case-bar-descriptor {
      display: none;
    }
  }

  /* A phone held sideways has no height to spare; the header scrolls away there too. */
  @media (max-height: 500px) {
    .case-bar {
      display: none;
    }

    :global(html:has(.case-bar)) {
      scroll-padding-top: 16px;
    }
  }

  /* On paper the bar would repeat over every page, and the buttons do nothing. */
  @media print {
    .case-bar,
    .toc,
    .case :global(.open-full),
    .case :global(.full-diagram) {
      display: none !important;
    }
  }

  .case {
    --toc-width: 196px;
    --body-gap: 64px;
  }

  /* Hero */
  .hero {
    display: grid;
    gap: 24px;
    padding-top: 16px;
  }

  h1 {
    font-size: clamp(2.1rem, 4.2vw, 3.1rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 0 0 16px;
  }

  .descriptor {
    margin: -8px 0 16px;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--muted);
  }

  .byline {
    margin: -6px 0 16px;
    font-size: 14px;
    color: var(--muted);
  }

  .outcome {
    max-width: 36em;
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .meta-card {
    align-self: start;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
  }

  .meta-card dl {
    display: grid;
    gap: 14px;
    margin: 0;
  }

  dt {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 2px;
  }

  dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
  }

  .stack {
    color: var(--muted);
  }

  .meta-card :global(.links-out) {
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  /* Results at a glance */
  /* Flex rather than grid, so a short last row stretches instead of leaving an empty cell. */
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  /* Two or three numbers would stretch into wide, empty boxes. They sit in one row of equal columns
     instead, as wide as they need up to 220px each, and narrow together on small screens. */
  .stats:not(:has(li:nth-child(4))) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 220px);
    width: fit-content;
    max-width: 100%;
  }

  .stats li {
    flex: 1 1 150px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px;
    background: var(--bg);
  }

  .stats .value {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 1.2;
    color: var(--accent);
  }

  .stats .label {
    font-size: 14px;
    line-height: 1.4;
    color: var(--muted);
  }

  .stats + .stage,
  .privacy-note + .stage {
    margin-top: 24px;
  }

  .privacy-note {
    margin: 32px 0 0;
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
  }

  /* The one bold element: the stage that opens every case study */
  .result-value {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--accent);
  }

  .stage {
    margin-top: 40px;
    padding: clamp(16px, 4vw, 48px);
    background: var(--surface);
    border-radius: 16px;
  }

  .stage :global(.product-moment) {
    margin: 0 auto;
  }

  .stage :global(.diagram) {
    margin: 0;
  }

  /* Body: section nav beside the reading column */
  .body {
    margin-top: 56px;
  }

  .toc {
    display: none;
  }

  .prose > :global(*:not(figure):not(.phone-only):not(ol)) {
    max-width: 680px;
  }

  .prose :global(h2) {
    margin: 3.25rem 0 1rem;
    scroll-margin-top: 24px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  /* Only the article's own lists; diagrams inside .prose are lists too. */
  .prose > :global(ol),
  .prose > :global(ul) {
    padding-left: 1.25rem;
  }

  .prose > :global(ol > li + li),
  .prose > :global(ul > li + li) {
    margin-top: 0.4rem;
  }

  /* Key decisions read as a ruled list: each one is a choice and its reason. On wider screens they sit
     in a two-column grid, so the rules above each pair line up; an odd last one spans the row. */
  .prose :global(#key-decisions + ol) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px 40px;
    padding: 0;
    list-style: none;
  }

  .prose :global(#key-decisions + ol > li) {
    margin: 0;
    padding: 16px 0 8px;
    border-top: 1px solid var(--border);
    line-height: 1.6;
  }

  .prose :global(#key-decisions + ol > li > strong:first-child) {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(#key-decisions + ol ul) {
    margin-top: 8px;
  }

  .next {
    margin: 72px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .next-project {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    text-decoration: none;
  }

  .next-label {
    font-size: 14px;
    color: var(--muted);
  }

  .next-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--text);
  }

  .next-project:hover .next-title {
    color: var(--accent);
  }

  @media (min-width: 760px) {
    .prose :global(#key-decisions + ol) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .prose :global(#key-decisions + ol > li:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  /* Below the two-column layout, show what the product does before its details. */
  @media (max-width: 1023px) {
    .case {
      display: flex;
      flex-direction: column;
    }

    .hero {
      display: contents;
    }

    .hero-text {
      order: 1;
      padding-top: 16px;
    }

    .stage {
      order: 2;
    }

    /* Full width, so its edge lines up with the illustration and numbers above it. */
    .meta-card {
      order: 3;
      align-self: stretch;
      margin-top: 24px;
    }

    .case > :not(.hero):not(.stage) {
      order: 4;
    }
  }

  /* Wide screens: one full-width column at the top. A side column always left a gap, because the
     intro and the details run to different lengths on every project. Instead the details sit in a
     quiet strip between two rules, with the stack taking whatever width is left. */
  @media (min-width: 1024px) {
    .hero {
      gap: 28px;
    }

    /* When the details need the room, the outbound link drops to its own row instead of squeezing them. */
    .meta-card {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 16px 48px;
      padding: 16px 0;
      border: 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }

    .meta-card dl {
      display: flex;
      flex: 1 1 820px;
      flex-wrap: wrap;
      gap: 16px 48px;
    }

    /* Role and type keep their width; only the stack gives way. */
    .meta-card dl > div {
      flex: 0 0 auto;
      max-width: 260px;
    }

    dd {
      text-wrap: pretty;
    }

    /* The stack takes the rest of the row, but never so little that it breaks a word per line. */
    .meta-card dl > div:last-child {
      flex: 1 1 320px;
      min-width: 240px;
      max-width: none;
    }

    /* Top-aligned with the values beside it: dropped by the height of a label. */
    .meta-card :global(.links-out) {
      flex: 0 0 auto;
      margin: calc(13px * 1.7 + 2px) 0 0;
      padding: 0;
      border: 0;
    }

    .stats {
      margin-top: 28px;
    }

    .stage {
      margin-top: 24px;
      padding: 32px;
    }

    .body {
      display: grid;
      grid-template-columns: var(--toc-width) minmax(0, 1fr);
      gap: var(--body-gap);
      align-items: start;
    }

    .toc {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--case-bar) + 24px);
    }

    .toc ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-left: 1px solid var(--border);
    }

    .toc a {
      display: block;
      margin-left: -1px;
      padding: 6px 0 6px 14px;
      border-left: 2px solid transparent;
      font-size: 14px;
      line-height: 1.4;
      color: var(--muted);
      text-decoration: none;
    }

    .toc a:hover {
      color: var(--text);
    }

    .toc a[aria-current='true'] {
      border-left-color: var(--accent);
      color: var(--text);
    }

    /* The nav column belongs to the nav alone: diagrams fill the reading column
       (its left edge to the page's right edge) and never pass under the sticky nav. */
  }
</style>
