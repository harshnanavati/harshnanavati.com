---
// A project's diagrams inside its "How it works" section.
// Until a video exists, the first diagram is already shown in the video slot
// at the top of the page, so it isn't repeated here.
import { getEntry } from 'astro:content';
import { DIAGRAMS, type WorkSlug } from '../diagrams';
import Diagram from './Diagram.astro';

interface Props {
  slug: WorkSlug;
  index: number;
}

const { slug, index } = Astro.props;
const entry = await getEntry('work', slug);
const shownInVideoSlot = index === 0 && !entry?.data.youtubeId;
---

{
  shownInVideoSlot ? (
    <p class="muted see-above">The architecture diagram is at the top of this page.</p>
  ) : (
    <Diagram diagram={DIAGRAMS[slug][index]} />
  )
}

<style>
  .see-above {
    font-size: 14px;
    font-style: italic;
  }
</style>
