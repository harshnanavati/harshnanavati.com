---
// A project card: an optional scaled-down preview of the project's illustration (passed in the
// "preview" slot), then its name, descriptor, one-line outcome and tags.
interface Props {
  href: string;
  title: string;
  descriptor?: string;
  outcome: string;
  tags: string[];
}

const { href, title, descriptor, outcome, tags } = Astro.props;
const hasPreview = Astro.slots.has('preview');
---

<li class="row">
  <a href={href} class:list={{ 'text-only': !hasPreview }}>
    {
      hasPreview && (
        <span class="preview" aria-hidden="true" inert data-nosnippet>
          <span class="preview-label">Illustration</span>
          <span class="preview-inner">
            <slot name="preview" />
          </span>
        </span>
      )
    }
    <span class="text">
      <span class="title">{title}</span>
      {descriptor && <span class="descriptor">{descriptor}</span>}
      <span class="outcome">{outcome}</span>
      <span class="tags">
        {tags.map((tag) => <span class="tag mono">{tag}</span>)}
      </span>
    </span>
  </a>
</li>

<style>
  .row {
    list-style: none;
  }

  /* The card's outline is a step stronger than the site's hairlines, so each project sits apart
     from its neighbours on a white page, without a shadow. */
  a {
    --card-line: color-mix(in srgb, var(--border) 84%, var(--muted));
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--card-line);
    border-radius: 14px;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  a:hover {
    border-color: var(--accent);
  }

  /* The real illustration, laid out wider than the card and scaled down to fit it (--scale).
     Narrower cards get a taller window, so the part that matters isn't cut off. */
  .preview {
    --scale: 0.75;
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--card-line);
  }

  /* Large enough to read, cut off with a soft fade into the window's own background, so the
     rule between illustration and text stays crisp and each card reads as one unit. */
  .preview::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 36px;
    background: linear-gradient(to bottom, transparent, var(--surface));
  }

  /* Two cards to a row: a shorter, slightly smaller window keeps the card compact. */
  @media (min-width: 1100px) {
    .preview {
      --scale: 0.68;
      aspect-ratio: 2 / 1;
    }
  }

  /* Inset 16px at the sides, so the screen sits inside the card instead of doubling its border,
     with a band above it for the label: these are drawings of the product, not screenshots. */
  .preview-label {
    position: absolute;
    top: 5px;
    left: 16px;
    font-size: 12px;
    line-height: 18px;
    color: var(--muted);
  }

  .preview-inner {
    position: absolute;
    top: 28px;
    left: 50%;
    width: calc((100% - 32px) / var(--scale));
    transform: translateX(-50%) scale(var(--scale));
    transform-origin: top center;
    pointer-events: none;
  }

  /* A card shows just the illustration's screen: its notes and markers belong on the case study. */
  .preview-inner :global(.product-moment) {
    display: block;
  }

  .preview-inner :global(.notes),
  .preview-inner :global(.m) {
    display: none;
  }

  /* Tighter spacing inside the screen, so more of the conversation fits the window. */
  .preview-inner :global(.screen) {
    gap: 10px;
    padding: 16px;
  }

  /* The tags sit at the bottom, so they line up across a row of cards whatever the outcome's length. */
  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 20px 18px;
  }

  /* The project name is the first thing read on each card, so it's set large and heavy. */
  .title {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.2vw, 1.6rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .descriptor {
    margin: 2px 0 4px;
    font-size: 15px;
    font-weight: 500;
    color: var(--accent);
  }

  .outcome {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: auto;
    padding-top: 8px;
    color: var(--muted);
  }

  a:hover .title {
    color: var(--accent);
  }

  /* Without an illustration the text is the whole card, so it gets a little more room. */
  .text-only .text {
    padding: 22px 24px 24px;
  }
</style>
