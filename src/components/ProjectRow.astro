---
// A project card on the home page: a scaled-down preview of the project's illustration
// (passed in the "preview" slot), then its name, descriptor, one-line outcome and tags.
interface Props {
  href: string;
  title: string;
  descriptor?: string;
  outcome: string;
  tags: string[];
}

const { href, title, descriptor, outcome, tags } = Astro.props;
const hasPreview = Astro.slots.has('preview');
---

<li class="row">
  <a href={href}>
    {
      hasPreview && (
        <span class="preview" aria-hidden="true" inert>
          <span class="preview-inner">
            <slot name="preview" />
          </span>
          <span class="preview-label">Illustration</span>
        </span>
      )
    }
    <span class="text">
      <span class="title">{title}</span>
      {descriptor && <span class="descriptor">{descriptor}</span>}
      <span class="outcome">{outcome}</span>
      <span class="tags">
        {tags.map((tag) => <span class="tag mono">{tag}</span>)}
      </span>
    </span>
  </a>
</li>

<style>
  .row {
    list-style: none;
  }

  a {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  a:hover {
    border-color: var(--accent);
  }

  /* The real illustration, laid out wider than the card and scaled down to fit it. */
  .preview {
    position: relative;
    display: block;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    /* Large enough to read, cut off with a soft fade rather than a hard edge. */
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent);
  }

  .preview-inner {
    position: absolute;
    top: 18px;
    left: 50%;
    width: 133%;
    transform: translateX(-50%) scale(0.75);
    transform-origin: top center;
    pointer-events: none;
  }

  .preview-label {
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 1px 7px;
    border-radius: 4px;
    background: var(--bg);
    font-size: 12px;
    color: var(--muted);
  }

  .preview-inner :global(figcaption) {
    display: none;
  }

  .text {
    display: grid;
    gap: 4px;
    padding: 18px 20px 20px;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .descriptor {
    margin-top: -2px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }

  .outcome {
    color: var(--muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 4px;
    color: var(--muted);
  }

  a:hover .title {
    color: var(--accent);
  }
</style>
