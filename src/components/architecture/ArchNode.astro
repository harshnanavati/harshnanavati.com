---
// One component in an architecture diagram: a box (or a database cylinder) with a
// plain-English label and optional technology notes, centred in the shape.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string | string[];
  tech?: string | string[];
  /** Highlights the project's key idea. Each diagram has exactly one. */
  keyIdea?: boolean;
  /** Draw as a database cylinder. */
  store?: boolean;
}

const { x, y, w, h, label, tech, keyIdea = false, store = false } = Astro.props;
const labels = Array.isArray(label) ? label : [label];
const techs = tech === undefined ? [] : Array.isArray(tech) ? tech : [tech];

const LABEL_LINE = 16;
const TECH_LINE = 14;
const cx = x + w / 2;
const lid = store ? 8 : 0;
const blockHeight = labels.length * LABEL_LINE + techs.length * TECH_LINE;
const top = y + lid + (h - lid - blockHeight) / 2;
const labelY = labels.map((_, i) => top + 12 + i * LABEL_LINE);
const techY = techs.map((_, i) => top + labels.length * LABEL_LINE + 10 + i * TECH_LINE);
const rx = w / 2;
---

<g class:list={['node', { key: keyIdea, store }]}>
  {
    store ? (
      <>
        <path d={`M${x} ${y + lid} a${rx} ${lid} 0 0 0 ${w} 0 v${h - lid * 2} a${rx} ${lid} 0 0 1 ${-w} 0 z`} />
        <ellipse cx={cx} cy={y + lid} rx={rx} ry={lid} />
      </>
    ) : (
      <rect x={x} y={y} width={w} height={h} rx="6" />
    )
  }
  {
    labels.map((text, i) => (
      <text class="label" x={cx} y={labelY[i]} text-anchor="middle">
        {text}
      </text>
    ))
  }
  {
    techs.map((text, i) => (
      <text class="tech" x={cx} y={techY[i]} text-anchor="middle">
        {text}
      </text>
    ))
  }
</g>
