---
// Illustration of photo tagging, drawn with silhouettes only: faces matched to players, sure matches
// tagged automatically and an unsure one sent to staff. No real photos, faces or players; everything
// is a vector drawing with invented numbers.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'Faces matched to players', text: 'Each face in a tournament photo is compared with player photos on file.' },
  {
    title: 'Sure matches tag themselves',
    text: "Unsure ones go to a person, so mistakes don't slip through. Manual tagging dropped by an estimated ~70%.",
  },
];

const people = [
  { label: 'Player 7, 91% match', sure: true },
  { label: 'Player 12, 88% match', sure: true },
  { label: '62%, needs a check', sure: false },
];
---

<MomentFrame notes={notes}>
  <div class="at">
    <Mark n={1} />
    <div class="photo" role="img" aria-label="A tournament photo of three players drawn as silhouettes, two matched and one unsure">
      {
        people.map((p) => (
          <div class="person">
            <span class:list={['tag', { unsure: !p.sure }]}>{p.label}</span>
            <span class="face">
              <span class:list={['box', { unsure: !p.sure }]} />
              <span class="head" />
            </span>
            <span class="body" />
          </div>
        ))
      }
    </div>
  </div>
  <div class="outcomes at">
    <Mark n={2} />
    <p class="outcome key"><strong>2 players</strong>tagged automatically</p>
    <p class="outcome"><strong>1 face</strong>sent to staff to check</p>
  </div>
</MomentFrame>

<style>
  .photo {
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    min-height: 210px;
    padding: 16px 12px 0;
    overflow: hidden;
    border-radius: 10px;
    background: color-mix(in srgb, var(--muted) 16%, var(--bg));
  }

  .person {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 30%;
    max-width: 120px;
  }

  .face {
    position: relative;
    margin-bottom: 6px;
  }

  .head {
    display: block;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--muted) 55%, var(--bg));
  }

  .body {
    width: 100%;
    max-width: 92px;
    height: 96px;
    border-radius: 46px 46px 0 0;
    background: color-mix(in srgb, var(--muted) 55%, var(--bg));
  }

  /* The match box sits around the head; dashed when the match isn't sure enough. */
  .box {
    position: absolute;
    inset: -8px;
    border: 2px solid var(--accent);
    border-radius: 6px;
  }

  .tag {
    margin-bottom: 18px;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--accent);
    color: var(--bg);
    font-size: 12.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .box.unsure {
    border-style: dashed;
    border-color: #8a7a3a;
  }

  .tag.unsure {
    background: #8a7a3a;
    color: #fff;
  }

  .outcomes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .outcome {
    margin: 0;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 14px;
  }

  .outcome strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
  }

  @media (max-width: 520px) {
    .tag {
      font-size: 11px;
      white-space: normal;
      text-align: center;
    }
  }
</style>
