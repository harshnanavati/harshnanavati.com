---
// Illustration of a QuantumCopilot answer: the question, the exact inputs the LLM extracts from it, and
// the scenarios the calculation engine returns. Example numbers only, computed here with the standard
// EMI formula; not a screenshot of the live product.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const PRINCIPAL = 2_000_000;
const YEARS = 15;
const RATES = [9, 8.5, 8];

function emi(principal: number, annualRate: number, years: number) {
  const r = annualRate / 1200;
  const n = years * 12;
  const f = (1 + r) ** n;
  return (principal * r * f) / (f - 1);
}

const inr = (n: number) => `₹${Math.round(n).toLocaleString('en-IN')}`;
const scenarios = RATES.map((rate) => {
  const monthly = emi(PRINCIPAL, rate, YEARS);
  return { rate, monthly, interest: monthly * YEARS * 12 - PRINCIPAL };
});

const notes = [
  { title: 'Borrowers ask in plain English', text: 'About any of six loan products.' },
  { title: 'The AI turns it into exact inputs', text: 'Loan type, amount, term and the rates to compare.' },
  { title: 'A calculation engine does the maths', text: 'Every figure is calculated, never made up by the AI.' },
];
---

<MomentFrame notes={notes}>
  <p class="bubble user at"><Mark n={1} />What's my EMI on a ₹20 lakh home loan over 15 years? And what if the rate drops?</p>
  <p class="parsed at">
    <Mark n={2} />
    <span>Understood as</span>
    <span class="chip">Home loan</span>
    <span class="chip">{inr(PRINCIPAL)}</span>
    <span class="chip">{YEARS} years</span>
    <span class="chip">{RATES.map((r) => `${r.toFixed(1)}%`).join(', ')}</span>
  </p>
  <div class="result key at">
    <Mark n={3} />
    <table>
      <thead>
        <tr><th scope="col">Rate</th><th scope="col">Monthly EMI</th><th scope="col">Total interest</th></tr>
      </thead>
      <tbody>
        {
          scenarios.map((s) => (
            <tr>
              <td>{s.rate.toFixed(1)}%</td>
              <td>{inr(s.monthly)}</td>
              <td>{inr(s.interest)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</MomentFrame>

<style>
  .parsed {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding-left: 20px;
    font-size: 13px;
    color: var(--muted);
  }

  .parsed .chip {
    color: var(--text);
  }

  .result {
    padding: 12px 14px;
    border-radius: 10px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    font-variant-numeric: tabular-nums;
  }

  th {
    padding: 4px 8px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
    text-align: left;
    color: var(--muted);
  }

  td {
    padding: 7px 8px;
    border-bottom: 1px solid var(--border);
  }

  tr:last-child td {
    border-bottom: 0;
  }

  th:not(:first-child),
  td:not(:first-child) {
    text-align: right;
  }
</style>
