---
// The panel every product illustration sits in, plus its caption. No fake browser
// chrome: captions always say it's an illustration, so nothing reads as a screenshot.
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="product-moment">
  <div class="window">
    <div class="window-body">
      <slot />
    </div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .product-moment {
    margin: 0;
  }

  .window {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg);
  }

  .window-body {
    padding: 18px;
    font-size: 14.5px;
    line-height: 1.55;
  }

  figcaption {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 420px) {
    .window-body {
      padding: 12px;
      font-size: 14px;
    }
  }
</style>
