---
import ArchFigure from '../architecture/ArchFigure.astro';
import ArchNode from '../architecture/ArchNode.astro';
import ArchZone from '../architecture/ArchZone.astro';

const label =
  'CrickPal Intelligence Layer architecture. An analyst writes a feature request in plain English with worked examples. ' +
  'An LLM agent writes the feature code, and a verification harness runs four checks: golden examples, mirror symmetry, replay leakage and determinism. ' +
  'Failures go back to the agent, which may repair its code or spec but never the analyst’s examples. Passing features need human approval before they go live. ' +
  'Live features feed the model pipeline: match history from MongoDB is replayed in date order with only the data legal at each prediction moment, ' +
  'Elo ratings and features feed a logistic regression trained on chronological splits, and backtests count how often the test window has been scored. ' +
  'State and an LLM call ledger are kept in SQL Server or SQLite. The platform is served through FastAPI and a Streamlit studio.';
---

<ArchFigure label={label} height={450}>
  <ArchZone x={150} y={20} w={690} h={170} label="Feature agent" />
  <ArchZone x={150} y={210} w={690} h={120} label="Model pipeline · FastAPI" />
  <ArchZone x={150} y={340} w={690} h={100} label="Storage" />

  <line class="flow" x1="130" y1="96" x2="168" y2="96" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="310" y1="96" x2="328" y2="96" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="554" y1="96" x2="573" y2="96" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="690" y1="96" x2="708" y2="96" marker-end="url(#arch-arrow)"></line>
  <polyline class="data" points="442,132 442,160 240,160 240,134" marker-end="url(#arch-arrow)"></polyline>
  <text class="tech" x="341" y="178" text-anchor="middle">fails: repair code or spec, never the examples</text>

  <polyline class="flow" points="770,132 770,200 415,200 415,248" marker-end="url(#arch-arrow)"></polyline>
  <line class="flow" x1="342" y1="282" x2="358" y2="282" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="470" y1="282" x2="488" y2="282" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="655" y1="282" x2="674" y2="282" marker-end="url(#arch-arrow)"></line>
  <polyline class="data" points="256,372 256,316" marker-end="url(#arch-arrow)"></polyline>
  <polyline class="data" points="753,314 753,405 642,405" marker-end="url(#arch-arrow)"></polyline>

  <text class="zone-label" x="70" y="50" text-anchor="middle">Analyst</text>
  <ArchNode x={10} y={60} w={120} h={72} label="Feature request" tech={['plain English', '+ worked', 'examples']} />
  <ArchNode x={170} y={60} w={140} h={72} label={['LLM writes', 'feature code']} tech="openai" />
  <ArchNode
    x={330}
    y={60}
    w={224}
    h={72}
    label="Verification harness"
    tech={['golden · mirror symmetry', 'replay leakage · determinism']}
    keyIdea
  />
  <ArchNode x={575} y={60} w={115} h={72} label={['Human', 'approval']} />
  <ArchNode x={710} y={60} w={120} h={72} label={['Feature', 'goes live']} />

  <ArchNode x={170} y={250} w={172} h={64} label="Chronological replay" tech="legal data per moment" />
  <ArchNode x={360} y={250} w={110} h={64} label={['Elo ratings', '+ features']} />
  <ArchNode x={490} y={250} w={165} h={64} label="Logistic regression" tech="chronological splits" />
  <ArchNode x={676} y={250} w={154} h={64} label="Backtests" tech="test-window counter" />

  <ArchNode x={191} y={372} w={130} h={66} label="MongoDB" tech="match history" store />
  <ArchNode x={482} y={372} w={160} h={66} label="SQL Server / SQLite" tech="state · LLM ledger" store />
</ArchFigure>
