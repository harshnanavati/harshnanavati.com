---
// Illustration of the concierge: an answer from the cached FAQs with suggested follow-ups, and a
// fixed reply for a request it can't handle. Questions and answers are made up.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'Answers from about 50 FAQs', text: "They all fit in one cached prompt, so there's no search step that can miss." },
  { title: 'Suggests what to ask next', text: 'Only from the real FAQ list, never invented.' },
  { title: 'Clear limits', text: 'Out-of-scope requests get a fixed reply, so it never promises anything.' },
];
---

<MomentFrame notes={notes}>
  <p class="bubble user">Anywhere good to eat near the fields?</p>
  <div class="bubble ai at">
    <Mark n={1} />Three family places are within a 10-minute walk, and two take large groups without a booking.
    <span class="chips follow"><Mark n={2} /><span class="chip">Late-night food</span><span class="chip">Parking nearby</span></span>
  </div>
  <p class="bubble user">Can you book us a table for tonight?</p>
  <p class="bubble ai key at">
    <Mark n={3} />I can't make bookings, but the event help desk can point you to places that take reservations.
  </p>
</MomentFrame>

<style>
  /* The second marker sits in line with the suggestions it points to. */
  .follow {
    align-items: center;
  }

  .follow :global(.m) {
    width: 18px;
    height: 18px;
    font-size: 11px;
  }
</style>
