---
// Illustration of the feature studio: an analyst's idea, the feature code the agent writes, the
// automatic checks it must pass, and the human approval. The feature is an example, not output from
// the real system.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'An analyst describes the idea', text: 'In plain English, with no code.' },
  { title: 'An AI agent writes the code', text: 'It turns the idea into a prediction feature.' },
  { title: 'Automatic tests catch bad code', text: 'If a test fails, the agent repairs the code and tries again.' },
  { title: 'A person approves it', text: 'Nothing goes live without a human sign-off.' },
];

// Plain-English names for the harness's checks: golden examples, determinism, replay leakage, mirror symmetry.
const checks = ['Matches the worked examples', 'Same answer on every run', 'Never sees future results', 'Fair to both teams'];
---

<MomentFrame notes={notes}>
  <p class="bubble user idea at">
    <Mark n={1} /><span class="label">Analyst's idea</span>Home team's win rate at this ground over the last two years
  </p>
  <div class="at">
    <Mark n={2} />
    <pre class="code"><code><span class="kw">def</span> home_win_rate(match):
    games = past_matches(match.ground, years=2)
    <span class="kw">return</span> wins(games, match.home) / len(games)</code></pre>
  </div>
  <div class="checks key at">
    <Mark n={3} />
    <ul>
      {
        checks.map((check) => (
          <li>
            <span class="tick" aria-hidden="true">
              ✓
            </span>
            {check}
          </li>
        ))
      }
    </ul>
  </div>
  <span class="approve at"><Mark n={4} />Approve feature</span>
</MomentFrame>

<style>
  .bubble.idea {
    justify-self: stretch;
    max-width: none;
  }

  .code {
    margin: 0;
    padding: 12px 14px;
    white-space: pre-wrap;
    border-radius: 8px;
    background: #1f2430;
    color: #e7e9ee;
    font: 13px/1.6 var(--font-mono);
  }

  .kw {
    color: #9fb5e8;
  }

  .checks {
    padding: 12px;
    border-radius: 8px;
    font-size: 14px;
  }

  .checks ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    display: flex;
    gap: 8px;
  }

  .tick {
    font-weight: 700;
    color: var(--accent);
  }

  .approve {
    justify-self: end;
    padding: 8px 16px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .checks ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
