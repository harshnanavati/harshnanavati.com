---
import ArchFigure from '../architecture/ArchFigure.astro';
import ArchNode from '../architecture/ArchNode.astro';
import ArchZone from '../architecture/ArchZone.astro';

const label =
  'DocuPilot architecture. In a background task, an admin upload is checked for duplicates with SHA-256, parsed for structure by Docling with OCR and table detection, ' +
  'split into structure-aware chunks that keep the page and position, embedded, and stored in one FAISS index per document. ' +
  'When staff ask a question, the role in their login token decides which documents may be searched; each allowed index is searched, ' +
  'GPT-4o-mini writes the answer, and answer-grounded citation selection decides which passages are cited. ' +
  'The answer comes back with page highlights, and every query is logged to SQL Server with latency, citations and feedback.';
---

<ArchFigure label={label} height={440}>
  <ArchZone x={150} y={20} w={690} h={120} label="Ingest · background task" />
  <ArchZone x={150} y={160} w={690} h={150} label="Ask · FastAPI with JWT login" />
  <ArchZone x={150} y={330} w={690} h={100} label="Storage" />

  <line class="flow" x1="130" y1="87" x2="168" y2="87" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="265" y1="87" x2="278" y2="87" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="400" y1="87" x2="413" y2="87" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="555" y1="87" x2="568" y2="87" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="750" y1="87" x2="763" y2="87" marker-end="url(#arch-arrow)"></line>

  <line class="flow" x1="130" y1="232" x2="168" y2="232" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="326" y1="232" x2="338" y2="232" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="460" y1="232" x2="473" y2="232" marker-end="url(#arch-arrow)"></line>
  <line class="flow" x1="645" y1="232" x2="658" y2="232" marker-end="url(#arch-arrow)"></line>
  <polyline class="flow" points="745,264 745,286 70,286 70,296" marker-end="url(#arch-arrow)"></polyline>

  <polyline class="data" points="800,124 800,150 400,150 400,198" marker-end="url(#arch-arrow)"></polyline>
  <text class="tech" x="600" y="146" text-anchor="middle">indexes read at question time</text>
  <polyline class="data" points="560,264 560,352" marker-end="url(#arch-arrow)"></polyline>
  <text class="tech" x="568" y="322">every query logged</text>

  <text class="zone-label" x="70" y="46" text-anchor="middle">Admin</text>
  <ArchNode x={10} y={55} w={120} h={64} label="Upload" tech="pdf · docx" />
  <ArchNode x={170} y={55} w={95} h={64} label="Dedup" tech="sha-256" />
  <ArchNode x={280} y={55} w={120} h={64} label="Parse structure" tech={['docling · ocr', 'tables · gpu']} />
  <ArchNode x={415} y={55} w={140} h={64} label={['Structure-aware', 'chunks']} tech="page + bbox kept" />
  <ArchNode x={570} y={55} w={180} h={64} label="Embed" tech="text-embedding-3-small" />
  <ArchNode x={765} y={55} w={70} h={69} label="FAISS" tech="per doc" store />

  <text class="zone-label" x="70" y="191" text-anchor="middle">Staff</text>
  <ArchNode x={10} y={200} w={120} h={64} label="Question" tech="role from JWT" />
  <ArchNode x={170} y={200} w={156} h={64} label="Allowed documents" tech="narrow, never widen" />
  <ArchNode x={340} y={200} w={120} h={64} label="Search each" tech="faiss · top 8" />
  <ArchNode x={475} y={200} w={170} h={64} label="Write the answer" tech="gpt-4o-mini · history" />
  <ArchNode x={660} y={200} w={170} h={64} label={['Answer-grounded', 'citation selection']} tech="floor · ratio to best" keyIdea />
  <ArchNode x={5} y={298} w={130} h={56} label="Answer" tech="page highlights" />
  <ArchNode x={495} y={354} w={130} h={66} label="SQL Server" tech="logs · feedback" store />
</ArchFigure>
