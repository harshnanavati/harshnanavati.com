---
// Illustration of a DocuPilot answer and the highlighted source page it came from.
// The document and question are made up; nothing comes from the client's material.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'Staff ask in plain English', text: 'No digging through hundreds of pages of procedures.' },
  { title: 'The answer comes from company documents', text: 'The AI answers from the passages it finds, not from memory.' },
  { title: 'Every answer shows its source', text: 'One click opens the exact page, with the passage highlighted.' },
];
---

<MomentFrame notes={notes}>
  <p class="bubble user at"><Mark n={1} />What do I do if the cash drawer is short at closing?</p>
  <p class="bubble ai at">
    <Mark n={2} />Recount with a second staff member present, then record the difference on the closing sheet.
  </p>
  <div class="page key at">
    <Mark n={3} />
    <span class="label">Cash Handling SOP, page 14</span>
    <span class="lines"><i></i><i></i></span>
    <p class="passage">
      If the closing count is short, recount with a second staff member present and record the variance on the closing
      sheet.
    </p>
    <span class="lines"><i></i><i></i><i></i></span>
  </div>
</MomentFrame>

<style>
  .page {
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 13.5px;
  }

  /* Grey bars stand in for the rest of the page's text. */
  .lines i {
    display: block;
    height: 7px;
    margin: 6px 0;
    border-radius: 4px;
    background: color-mix(in srgb, var(--muted) 18%, var(--bg));
  }

  .lines i:nth-child(2) {
    width: 82%;
  }

  .lines i:nth-child(3) {
    width: 64%;
  }

  .passage {
    margin: 8px 0;
    padding: 8px 10px;
    border-left: 3px solid var(--accent);
    background: var(--bg);
  }
</style>
