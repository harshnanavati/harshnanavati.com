---
// Illustration of a graded topic quiz: the learner's answers checked against the answer key, the
// score against the pass mark, and the next topic unlocked. Questions and answers are made up.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'AI agents write the lesson and quiz', text: 'Every question comes with its answer key.' },
  { title: 'Code grades the answers', text: 'Checked against the key, so the same answers always get the same score.' },
  { title: 'Pass to move on', text: '70% on a topic quiz unlocks the next topic.' },
];

const questions = [
  { q: 'What does len([3, 1, 4]) return?', answer: '3', correct: true },
  { q: 'Which method adds an item to the end of a list?', answer: 'append()', correct: true },
  { q: 'For nums = [2, 4, 6], what is nums[-1]?', answer: '2', correct: false, key: '6' },
  { q: 'What does [1, 2] + [3] give?', answer: '[1, 2, 3]', correct: true },
];
---

<MomentFrame notes={notes}>
  <p class="quiz-title">Lists, beginner quiz</p>
  <div class="at">
    <Mark n={1} />
    <ol class="questions">
    {
      questions.map((item, i) => (
        <li class:list={['q', { 'key at': i === 2 }]}>
          {i === 2 && <Mark n={2} />}
          <span>{item.q}</span>
          <span class="answer">
            {item.answer}{' '}
            {item.correct ? (
              <span class="tick" aria-label="correct">
                ✓
              </span>
            ) : (
              <>
                <span class="cross" aria-label="wrong">
                  ✗
                </span>{' '}
                key: {item.key}
              </>
            )}
          </span>
        </li>
      ))
    }
    </ol>
  </div>
  <p class="result at">
    <Mark n={3} />
    <span><strong>3 of 4 correct, 75%.</strong> <span class="pass">Pass mark 70%</span></span>
    <span class="unlocked">Next topic unlocked: Dictionaries</span>
  </p>
</MomentFrame>

<style>
  .quiz-title {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }

  .questions {
    margin: 0;
    padding: 0 0 0 4px;
    list-style: none;
  }

  .q {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 4px 12px;
    padding: 8px 0 8px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 14.5px;
  }

  .q.key {
    padding-right: 10px;
    border-radius: 6px;
  }

  .answer {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .tick {
    font-weight: 700;
    color: var(--accent);
  }

  .cross {
    font-weight: 700;
    color: #b54a4a;
  }

  .result {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    margin: 0;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--surface);
  }

  .pass {
    color: var(--muted);
  }

  .unlocked {
    padding: 8px 14px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--bg);
    font-size: 14px;
    font-weight: 500;
  }
</style>
