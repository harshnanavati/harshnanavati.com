---
// Illustration of the RAG support chatbot: a personal answer from the family's schedule, and a staff
// correction that fixes an answer for everyone. Questions and answers are made up.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'Personal answers', text: "It reads the family's own schedule, not just the general FAQs." },
  { title: 'Staff fix a wrong answer once', text: 'The correction goes straight into the knowledge base.' },
  { title: 'Everyone gets the fixed answer', text: 'The next person who asks gets the corrected answer, so fewer questions reach staff.' },
];
---

<MomentFrame notes={notes}>
  <p class="bubble user">When does my team play next?</p>
  <div class="bubble ai at">
    <Mark n={1} />Field 4, tomorrow at 2:30 PM. Check in at the field desk 45 minutes before.
    <span class="chips"><span class="chip">From your team's schedule</span></span>
  </div>
  <p class="bubble user">Can we bring our own canopy to the field?</p>
  <p class="bubble ai key at">
    <Mark n={2} /><span class="label">Staff correction, saved to the knowledge base</span>Canopies are allowed behind
    the dugout fence, not along the foul lines.
  </p>
  <div class="bubble ai at">
    <Mark n={3} />Yes, team canopies are allowed behind the dugout fence, but not along the foul lines.
    <span class="chips"><span class="chip">From a staff correction</span></span>
  </div>
</MomentFrame>
