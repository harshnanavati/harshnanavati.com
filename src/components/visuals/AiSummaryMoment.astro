---
// Illustration of a live match page: the score in plain words, the AI's headline and summary, and
// the summary refreshing as the match goes on. Teams and scores are invented.
import Mark from './Mark.astro';
import MomentFrame from './MomentFrame.astro';

const notes = [
  { title: 'Live match data comes in', text: "Every ball's score streams in as the match is played." },
  { title: 'The AI writes the story', text: 'A headline and short summary fans can read in seconds.' },
  { title: 'It keeps up with the match', text: 'Refreshed as play goes on, on a self-hosted model with no per-token bill.' },
];
---

<MomentFrame notes={notes}>
  <p class="score at">
    <Mark n={1} /><span>Northern Hawks</span><strong>132 for 4</strong><span class="context">after 16 of 20 overs, against Coastal Kings</span>
  </p>
  <div class="story key at">
    <Mark n={2} />
    <p class="headline">Hawks recover from 42 for 3 with a 90-run stand</p>
    <p class="summary">
      Early wickets left the Hawks in trouble, but a patient partnership turned the innings around. They head into the
      last four overs with wickets in hand and a strong total in sight.
    </p>
  </div>
  <p class="refresh at">
    <Mark n={3} />
    <span>Over 6</span><span class="pip done"></span><span class="track"></span>
    <span>Over 12</span><span class="pip done"></span><span class="track"></span>
    <span>Over 16, latest</span><span class="pip done"></span><span class="track"></span><span class="pip"></span>
  </p>
</MomentFrame>

<style>
  .score {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin: 0;
    padding: 0 0 10px 20px;
    border-bottom: 1px solid var(--border);
  }

  .score strong {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 600;
    color: var(--accent);
  }

  .context {
    color: var(--muted);
  }

  .story {
    padding: 14px 16px;
    border-radius: 10px;
  }

  .headline {
    margin: 0 0 6px;
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.3;
  }

  .summary {
    margin: 0;
  }

  /* A timeline of refreshes: filled points are summaries already written. */
  .refresh {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 4px 0 0 20px;
    font-size: 13px;
    color: var(--muted);
  }

  .pip {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border);
  }

  .pip.done {
    background: var(--accent);
  }

  .track {
    flex: 1;
    height: 2px;
    background: var(--border);
  }
</style>
