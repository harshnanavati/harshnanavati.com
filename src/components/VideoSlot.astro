---
// A YouTube video that loads only when clicked, with a plain link for no-JS visitors.
// Pages render this only once a video exists; there is no placeholder state.
import 'lite-youtube-embed/src/lite-yt-embed.css';

interface Props {
  title: string;
  youtubeId: string;
}

const { title, youtubeId } = Astro.props;
---

<section class="video-slot" aria-label={`Video: ${title}`}>
  <lite-youtube videoid={youtubeId} playlabel={title}>
    <a class="lite-youtube-fallback" href={`https://www.youtube.com/watch?v=${youtubeId}`}>
      Watch "{title}" on YouTube
    </a>
  </lite-youtube>
</section>

<script>
  import 'lite-youtube-embed';
</script>

<style>
  .video-slot {
    margin: 2rem 0;
  }

  lite-youtube {
    max-width: 100%;
    border-radius: 8px;
  }
</style>
