---
// A citation marker: a small numbered button that opens a card saying where a claim
// comes from, with a link to the evidence. Uses the native popover (keyboard and Esc
// work for free); browsers without popover support jump straight to the evidence.
interface Props {
  n: number;
  /** Unique within the page. */
  id: string;
  source: string;
  basis: string;
  href: string;
  linkText?: string;
}

const { n, id, source, basis, href, linkText = 'See the evidence' } = Astro.props;
const cardId = `cite-${id}`;
---

<button
  class="cite"
  type="button"
  popovertarget={cardId}
  data-href={href}
  aria-label={`Evidence ${n}: ${source}`}>{n}</button
><span class="cite-card" id={cardId} popover role="note" data-nosnippet>
  <span class="cite-source">Evidence {n} · {source}</span>
  <span class="cite-basis">{basis}</span>
  <a class="cite-link" href={href}>{linkText}</a>
</span>

<script>
  const supported = typeof HTMLElement !== 'undefined' && 'popover' in HTMLElement.prototype;
  const GAP = 8;
  const EDGE = 12;

  // Put the card under its marker, or above it when there isn't room below,
  // always inside the screen.
  function place(card: HTMLElement, button: HTMLElement) {
    const r = button.getBoundingClientRect();
    const width = Math.min(340, window.innerWidth - 2 * EDGE);
    card.style.width = `${width}px`;
    card.style.left = `${Math.min(Math.max(EDGE, r.left - 12), window.innerWidth - width - EDGE)}px`;
    const height = card.offsetHeight;
    const below = r.bottom + GAP;
    const above = r.top - GAP - height;
    const top = below + height <= window.innerHeight - EDGE || above < EDGE ? below : above;
    card.style.top = `${Math.max(EDGE, Math.min(top, window.innerHeight - height - EDGE))}px`;
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('button.cite')) {
    if (button.dataset.wired) continue;
    button.dataset.wired = '1';
    if (!supported) {
      button.addEventListener('click', () => (window.location.href = button.dataset.href ?? '#'));
      continue;
    }
    const card = document.getElementById(button.getAttribute('popovertarget') ?? '');
    if (!card) continue;
    // beforetoggle fires right away; toggle comes later, after any scroll already queued.
    card.addEventListener('beforetoggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') card.dataset.openedAt = String(window.scrollY);
    });
    card.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'open') place(card, button);
    });
  }

  // A fixed card would drift away from its marker, so close it once the page really
  // moves. The small nudge that brings a tapped marker into view doesn't count.
  const DRIFT = 40;
  const openCards = () => document.querySelectorAll<HTMLElement>('.cite-card:popover-open');
  if (supported) {
    window.addEventListener(
      'scroll',
      () => {
        for (const card of openCards()) {
          const openedAt = Number(card.dataset.openedAt ?? window.scrollY);
          if (Math.abs(window.scrollY - openedAt) > DRIFT) card.hidePopover();
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', () => {
      for (const card of openCards()) card.hidePopover();
    });
  }
</script>

<style>
  /* A quiet superscript: present for anyone who wants the evidence, out of the way otherwise. */
  .cite {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    margin: 0 0 0 1px;
    padding: 0 4px;
    border: 0;
    border-radius: 3px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    font: 600 12px/1 var(--font-sans);
    font-variant-numeric: tabular-nums;
    vertical-align: super;
    cursor: pointer;
  }

  /* A larger tap area around the small visible marker (about 38x34). */
  .cite::before {
    content: '';
    position: absolute;
    inset: -8px -10px;
  }

  .cite:hover,
  .cite:focus-visible {
    background: var(--accent);
    color: var(--bg);
  }

  .cite-card {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font: 400 14px/1.55 var(--font-sans);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
  }

  .cite-card:popover-open {
    display: grid;
    gap: 4px;
  }

  .cite-source {
    font-size: 12.5px;
    color: var(--muted);
  }

  .cite-link {
    margin-top: 4px;
    font-weight: 600;
  }
</style>
