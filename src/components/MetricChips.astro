---
interface Props {
  chips: { value: string; label: string }[];
}

const { chips } = Astro.props;
---

<ul class="chips">
  {
    chips.map((chip) => (
      <li>
        <span class="value">{chip.value}</span> <span class="label">{chip.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    list-style: none;
    margin: 1.5rem 0;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    font-size: 14px;
    color: var(--muted);
  }

  .value {
    font-size: 18px;
    font-weight: 500;
    color: var(--accent);
  }
</style>
